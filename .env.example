# ============================================================
# StepUp – Environment Variables
# ============================================================
# Copy this file: cp .env.example .env
# Required fields (*) must be filled before the app can start.
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=stepup                        # * DB username
POSTGRES_PASSWORD=                          # * DB password (do not leave empty)
POSTGRES_DB=stepup_db                       # * DB name

# --- Connection URLs ---
DATABASE_URL=postgresql+asyncpg://stepup:<password>@db:5432/stepup_db   # * App DB
TEST_DATABASE_URL=postgresql+asyncpg://stepup:<password>@db:5432/stepup_test  # * Test DB

# --- Application ---
FRONTEND_URL=http://localhost:3000          # * Frontend URL (for CORS)

# --- JWT ---
JWT_SECRET_KEY=                             # * Generate a strong key: openssl rand -hex 32

# --- Email (SendGrid) ---
SENDGRID_API_KEY=                           # * SendGrid API key (required for email)
SENDGRID_FROM_EMAIL=noreply@stepup.com     # * Sender email address

# --- GCS (Google Cloud Storage) ---
GCS_BUCKET_NAME=                            # File uploads (optional, required for upload feature)
GOOGLE_APPLICATION_CREDENTIALS=/app/gcs-key.json  # GCS key file path

# --- Rate Limiting ---
LOGIN_RATE_LIMIT=5/minute                   # Login endpoint rate limit (keep low in prod)

# --- Cookie Security ---
# true: production (HTTPS), false: local development (HTTP)
COOKIE_SECURE=false
